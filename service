"""Contiene la lógica de negocio de mi aplicación."""
from models.inventory import Inventory
from repositories.user_repository import InventoryRepository

class InventoryService:
    def __init__(self, repository: InventoryRepository) -> None:
        self.repository = repository

    def find_all(self):
        return self.repository.find_all()

    def create_one(self, fname: str, lname: str, email: str, age: int, product_name: str, price: float):
        item = Inventory(fname, lname, email, age, product_name, price)
        self.repository.create_one(item)
